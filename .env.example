# PostgreSQL (local Docker default shown)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cleaning_app

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Notifications (optional — stubs log to console when unset)
# NOTIFY_CHANNEL=EMAIL
# RESEND_API_KEY=
# NOTIFICATION_EMAIL_FROM=noreply@yourdomain.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
