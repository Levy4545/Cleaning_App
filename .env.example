# PostgreSQL (local Docker default shown)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cleaning_app

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Notifications — in-app is always on; email uses Gmail SMTP (recommended)
# ---------------------------------------------------------------------------
# Company Gmail / Google Workspace:
# 1. Enable 2-Step Verification on the Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (spaces optional)
# GMAIL_USER=bookings@yourcompany.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# NOTIFICATION_EMAIL_FROM="Master-Gold Cleaning <bookings@yourcompany.com>"
# Optional SMTP overrides (defaults: smtp.gmail.com:465)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Fallback transactional provider if Gmail is unset
# RESEND_API_KEY=
# NOTIFICATION_EMAIL_FROM=noreply@yourdomain.com

# Optional SMS (also sent when NOTIFY_CHANNEL=SMS)
# NOTIFY_CHANNEL=EMAIL
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Promote this email to ADMIN automatically on login/sync (dev bootstrap)
# ADMIN_BOOTSTRAP_EMAIL=you@example.com
