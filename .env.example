# ---------------------------------------------------------------------------
# Required (production = one Supabase project for Auth + app data)
# ---------------------------------------------------------------------------
# Project URL + anon (publishable) key: Settings → API Keys
# On Vercel add these as Secrets — do NOT use the NEXT_PUBLIC_ prefix
# (Vercel blocks NEXT_PUBLIC_* when the type is Secret).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Live site origin (no localhost). Google OAuth always returns here, then /dashboard.
# On Vercel you can omit this — it falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Postgres URI: Supabase → Connect → Transaction pooler (port 6543).
# Use the database password (Database settings), NOT the service_role API key.
# POSTGRES_URL is also accepted (Vercel / Neon alias).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cleaning_app

# Local Docker default is above. In production paste the pooler URI, for example:
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Optional — only if you add Supabase admin APIs later
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ---------------------------------------------------------------------------
# Notifications — in-app is always on; email uses Gmail SMTP (recommended)
# ---------------------------------------------------------------------------
# GMAIL_USER=bookings@yourcompany.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# NOTIFICATION_EMAIL_FROM="Master-Gold Cleaning <bookings@yourcompany.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# RESEND_API_KEY=
# NOTIFY_CHANNEL=EMAIL
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Promote this email to ADMIN automatically on login/sync (dev bootstrap)
# ADMIN_BOOTSTRAP_EMAIL=you@example.com
